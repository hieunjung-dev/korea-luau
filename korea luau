-- --------------------------------------------------------
local function sendChatMessage()
	loadOnlineData()
	local text = chatInput.Text
	if text:gsub("%s+", "") == "" then return end

	local myPunishInfo = globalData.Punishments[currentHWID] or {}

	-- 영구 챗정 및 타임아웃 상태 확인 (관리자/모더레이터 제외)
	if currentNick ~= "모더레이터" then
		if myPunishInfo.PermChatBan then
			chatInput.Text = ""
			chatInput.PlaceholderText = "영구 채팅 금지 상태입니다."
			return
		end

		if myPunishInfo.TimeoutUntil and os.time() < myPunishInfo.TimeoutUntil then
			chatInput.Text = ""
			chatInput.PlaceholderText = "타임아웃 적용 중입니다."
			return
		end
	end

	-- 욕설 자동 타임아웃 감지 (10분)
	local badWords = { "개새끼", "씨발", "병신", "존나", "지랄", "좆", "떵" }
	local isBad = false
	for _, w in ipairs(badWords) do
		if text:find(w) then
			isBad = true
			break
		end
	end

	if isBad and currentNick ~= "모더레이터" then
		globalData.Punishments[currentHWID] = globalData.Punishments[currentHWID] or {}
		globalData.Punishments[currentHWID].TimeoutUntil = os.time() + 600
		saveOnlineData()
		chatInput.Text = ""
		chatInput.PlaceholderText = "욕설 사용으로 10분간 타임아웃 되었습니다."
		return
	end

	-- 메시지 등록 및 전송 UI 생성
	chatInput.Text = ""

	local msgFrame = Instance.new("Frame")
	msgFrame.Size = UDim2.new(1, -12, 0, 48)
	msgFrame.BackgroundColor3 = Color3.fromRGB(28, 28, 35)
	msgFrame.Parent = chatScroll
	addCorner(msgFrame, 6)

	local profileBtn = Instance.new("ImageButton")
	profileBtn.Size = UDim2.new(0, 36, 0, 36)
	profileBtn.Position = UDim2.new(0, 6, 0, 6)
	profileBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
	profileBtn.Image = "rbxthumb://type=AvatarHeadShot&id=" .. LocalPlayer.UserId .. "&w=150&h=150"
	profileBtn.Parent = msgFrame
	addCorner(profileBtn, 18)

	local nameLabel = Instance.new("TextLabel")
	nameLabel.Size = UDim2.new(1, -50, 0, 18)
	nameLabel.Position = UDim2.new(0, 48, 0, 4)
	nameLabel.BackgroundTransparency = 1
	nameLabel.Font = Enum.Font.GothamBold
	nameLabel.TextSize = 12
	nameLabel.TextXAlignment = Enum.TextXAlignment.Left
	nameLabel.Parent = msgFrame

	if currentNick == "모더레이터" then
		nameLabel.TextColor3 = Color3.fromRGB(255, 0, 0) -- R:255, G:0, B:0
		nameLabel.Text = currentNick
	else
		nameLabel.TextColor3 = Color3.fromRGB(220, 220, 220)
		nameLabel.Text = currentNick
	end

	-- 모더레이터 시점 시 유저 옆에 키 표시
	if currentNick == "모더레이터" and script_key ~= OWNER_KEY then
		nameLabel.Text = nameLabel.Text .. " (" .. script_key .. ")"
	end

	local contentLabel = Instance.new("TextLabel")
	contentLabel.Size = UDim2.new(1, -50, 0, 20)
	contentLabel.Position = UDim2.new(0, 48, 0, 22)
	contentLabel.BackgroundTransparency = 1
	contentLabel.Text = text
	contentLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
	contentLabel.Font = Enum.Font.Gotham
	contentLabel.TextSize = 13
	contentLabel.TextXAlignment = Enum.TextXAlignment.Left
	contentLabel.Parent = msgFrame

	-- 모더레이터가 유저 프로필(아바타) 클릭 시 제재 창 출력
	profileBtn.MouseButton1Click:Connect(function()
		if currentNick == "모더레이터" then
			selectedTargetKey = script_key
			adminMenu.Position = UDim2.new(0, profileBtn.AbsolutePosition.X, 0, profileBtn.AbsolutePosition.Y + 40)
			adminMenu.Visible = true
		end
	end)

	chatScroll.CanvasSize = UDim2.new(0, 0, 0, #chatScroll:GetChildren() * 54)
end

chatSendBtn.MouseButton1Click:Connect(sendChatMessage)
chatInput.FocusLost:Connect(function(enter)
	if enter then sendChatMessage() end
end)

