local function updateModPanel()
	for _, v in ipairs(modScroll:GetChildren()) do
		if v:IsA("Frame") then v:Destroy() end
	end

	local searchText = modSearchInput.Text:lower():gsub("%s+", "")

	if searchText ~= "" then
		-- 유저 검색 결과 출력
		for key, nick in pairs(globalData.Nicknames) do
			if nick:lower():find(searchText) then
				local f = Instance.new("Frame")
				f.Size = UDim2.new(1, 0, 0, 32)
				f.BackgroundColor3 = Color3.fromRGB(32, 32, 40)
				f.ZIndex = 22
				f.Parent = modScroll
				addCorner(f, 4)

				local lbl = Instance.new("TextLabel")
				lbl.Size = UDim2.new(0.7, 0, 1, 0)
				lbl.Position = UDim2.new(0, 8, 0, 0)
				lbl.BackgroundTransparency = 1
				lbl.Text = nick
				lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
				lbl.Font = Enum.Font.Gotham
				lbl.TextSize = 12
				lbl.TextXAlignment = Enum.TextXAlignment.Left
				lbl.ZIndex = 23
				lbl.Parent = f

				local sBtn = Instance.new("TextButton")
				sBtn.Size = UDim2.new(0, 28, 0, 24)
				sBtn.Position = UDim2.new(1, -34, 0, 4)
				sBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 65)
				sBtn.Text = "⚙️"
				sBtn.TextSize = 12
				sBtn.ZIndex = 23
				sBtn.Parent = f
				addCorner(sBtn, 4)

				sBtn.MouseButton1Click:Connect(function()
					selectedTargetKey = key
					adminMenu.Position = UDim2.new(0, sBtn.AbsolutePosition.X - 200, 0, sBtn.AbsolutePosition.Y)
					adminMenu.Visible = true
				end)
			end
		end
	else
		-- 처벌 적용 중인 유저 목록
		for hwid, pInfo in pairs(globalData.Punishments) do
			local targetKey = nil
			for k, h in pairs(globalData.Keys) do
				if h == hwid then targetKey = k break end
			end
			local targetNick = globalData.Nicknames[targetKey] or "미설정"

			local pList = {}
			if pInfo.PermBan then table.insert(pList, "영구정지") end
			if pInfo.PermChatBan then table.insert(pList, "영구챗정") end
			if pInfo.TimebanUntil and os.time() < pInfo.TimebanUntil then table.insert(pList, "타임밴") end
			if pInfo.TimeoutUntil and os.time() < pInfo.TimeoutUntil then table.insert(pList, "타임아웃") end

			if #pList > 0 then
				local f = Instance.new("Frame")
				f.Size = UDim2.new(1, 0, 0, 32)
				f.BackgroundColor3 = Color3.fromRGB(32, 32, 40)
				f.ZIndex = 22
				f.Parent = modScroll
				addCorner(f, 4)

				local lbl = Instance.new("TextLabel")
				lbl.Size = UDim2.new(0.65, 0, 1, 0)
				lbl.Position = UDim2.new(0, 8, 0, 0)
				lbl.BackgroundTransparency = 1
				lbl.Text = targetNick .. " (" .. table.concat(pList, ", ") .. ")"
				lbl.TextColor3 = Color3.fromRGB(240, 200, 100)
				lbl.Font = Enum.Font.Gotham
				lbl.TextSize = 11
				lbl.TextXAlignment = Enum.TextXAlignment.Left
				lbl.ZIndex = 23
				lbl.Parent = f

				local unbanBtn = Instance.new("TextButton")
				unbanBtn.Size = UDim2.new(0, 60, 0, 24)
				unbanBtn.Position = UDim2.new(1, -66, 0, 4)
				unbanBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
				unbanBtn.Text = "해제"
				unbanBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
				unbanBtn.Font = Enum.Font.GothamBold
				unbanBtn.TextSize = 11
				unbanBtn.ZIndex = 23
				unbanBtn.Parent = f
				addCorner(unbanBtn, 4)

				unbanBtn.MouseButton1Click:Connect(function()
					globalData.Punishments[hwid] = nil
					saveOnlineData()
					updateModPanel()
				end)
			end
		end
	end
end

