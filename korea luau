			noticeLabel.Text = "누군가 사용중인 닉네임입니다"
			task.delay(3, function()
				noticeLabel.Text = ""
				isProcessing = false
			end)
			return
		end

		-- 정상 등록 및 영구 귀속
		globalData.Nicknames[script_key] = inputStr
		saveOnlineData()
		currentNick = inputStr
		nickFrame:Destroy()
	end)

	repeat task.wait(0.5) until globalData.Nicknames[script_key]
end

