	local confirmBtn = Instance.new("TextButton")
	confirmBtn.Size = UDim2.new(0.5, 0, 0, 34)
	confirmBtn.Position = UDim2.new(0.25, 0, 0.55, 0)
	confirmBtn.BackgroundColor3 = Color3.fromRGB(45, 120, 210)
