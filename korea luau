	confirmBtn.Font = Enum.Font.GothamBold
	confirmBtn.TextSize = 14
	confirmBtn.Parent = nickFrame
	addCorner(confirmBtn, 6)

	local noticeLabel = Instance.new("TextLabel")
	noticeLabel.Size = UDim2.new(1, 0, 0, 30)
	noticeLabel.Position = UDim2.new(0, 0, 0.8, 0)
	noticeLabel.BackgroundTransparency = 1
	noticeLabel.Font = Enum.Font.GothamBold
	noticeLabel.TextSize = 13
	noticeLabel.Text = ""
	noticeLabel.Parent = nickFrame

	local isProcessing = false
	confirmBtn.MouseButton1Click:Connect(function()
		if isProcessing then return end
		local inputStr = nickInput.Text:gsub("%s+", "")
		if inputStr == "" then return end

		-- 제한된 닉네임 시도 검사
		if inputStr == "관리자" or inputStr == "모더레이터" or inputStr == "운영자" then
			noticeLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
			noticeLabel.Text = "key is locked."
			-- 키 영구 사용정지 처리
			globalData.Punishments[currentHWID] = globalData.Punishments[currentHWID] or {}
			globalData.Punishments[currentHWID].PermBan = true
			saveOnlineData()
			task.wait(2)
			LocalPlayer:Kick("key is locked.")
			return
		end

		-- 중복 닉네임 검사
		local isDuplicate = false
		for k, v in pairs(globalData.Nicknames) do
			if v == inputStr then
				isDuplicate = true
				break
