	return
end

-- 2. 온라인 HWID 데이터 읽기/쓰기 함수
local globalData = {
	Keys = {},       -- [Key] = HWID
	Nicknames = {},  -- [Key] = Nickname
	Punishments = {} -- [HWID] = { TimeoutUntil = timestamp, TimebanUntil = timestamp, PermBan = bool, PermChatBan = bool }
}

local function loadOnlineData()
	if isfile and readfile and isfile(DATA_SAVE_FILE) then
		pcall(function()
			local decoded = HttpService:JSONEncode(readfile(DATA_SAVE_FILE)) -- 파싱 오류 대비
			local data = HttpService:JSONDecode(readfile(DATA_SAVE_FILE))
			if data then globalData = data end
		end)
	end
	globalData.Keys = globalData.Keys or {}
	globalData.Nicknames = globalData.Nicknames or {}
	globalData.Punishments = globalData.Punishments or {}
end

local function saveOnlineData()
	if writefile then
		pcall(function()
			writefile(DATA_SAVE_FILE, HttpService:JSONEncode(globalData))
		end)
	end
end

loadOnlineData()

-- 3. HWID 귀속 검증
if globalData.Keys[script_key] then
	if globalData.Keys[script_key] ~= currentHWID then
		LocalPlayer:Kick("이미 사용된 키입니다")
		return
	end
else
	globalData.Keys[script_key] = currentHWID
	saveOnlineData()
end

-- 4. HWID 제재(타임밴 / 영구정지) 검증
local myPunish = globalData.Punishments[currentHWID] or {}

if myPunish.PermBan then
	LocalPlayer:Kick("이 키는 영구 정지되었습니다.")
	return
end

if myPunish.TimebanUntil and os.time() < myPunish.TimebanUntil then
	-- 타임밴 적용 시 화면 회색 오버레이 & 터치 통제 UI 생성
	local playerGui = LocalPlayer:WaitForChild("PlayerGui")
	local banGui = Instance.new("ScreenGui")
	banGui.Name = "TimeBanGui"
	banGui.ResetOnSpawn = false
	banGui.DisplayOrder = 999999
	banGui.Parent = playerGui

	local banFrame = Instance.new("TextButton") -- 입력 통제를 위해 TextButton 사용
	banFrame.Size = UDim2.new(1, 0, 1, 0)
	banFrame.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
	banFrame.BackgroundTransparency = 0.3
	banFrame.AutoButtonColor = false
	banFrame.Text = ""
	banFrame.Parent = banGui

	local banLabel = Instance.new("TextLabel")
	banLabel.Size = UDim2.new(0, 400, 0, 100)
	banLabel.AnchorPoint = Vector2.new(0.5, 0.5)
	banLabel.Position = UDim2.new(0.5, 0, 0.5, 0)
	banLabel.BackgroundTransparency = 1
	banLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
	banLabel.Font = Enum.Font.GothamBold
	banLabel.TextSize = 22
	banLabel.Parent = banFrame

	task.spawn(function()
		while true do
			local remain = (myPunish.TimebanUntil or 0) - os.time()
			if remain <= 0 then
				banGui:Destroy()
				break
			end
			local m = math.floor(remain / 60)
			local s = remain % 60
			banLabel.Text = string.format("타임밴 (%d분 %d초)", m, s)
			task.wait(1)
		end
	end)
	return
end

